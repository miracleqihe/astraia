{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Audit": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date",
          "title": "Created At",
          "type": "string"
        },
        "reviewed_by_human": {
          "title": "Reviewed By Human",
          "type": "boolean"
        },
        "ai_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Confidence"
        },
        "is_sample": {
          "default": false,
          "title": "Is Sample",
          "type": "boolean"
        },
        "reviewer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "review_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "public_release": {
          "default": false,
          "title": "Public Release",
          "type": "boolean"
        },
        "public_rights_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Rights Note"
        },
        "public_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Content Sha256"
        }
      },
      "required": [
        "created_at",
        "reviewed_by_human"
      ],
      "title": "Audit",
      "type": "object"
    },
    "MechanismReference": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Target Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "confirmed",
            "contested",
            "unverified",
            "refuted"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_note": {
          "minLength": 1,
          "title": "Evidence Note",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "status",
        "evidence_note"
      ],
      "title": "MechanismReference",
      "type": "object"
    },
    "Relation": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "INSTANCE_OF",
            "HAS_MOTIF",
            "TAGGED_OCM",
            "MIGRATED_TO",
            "EVOLVED_INTO",
            "VARIANT_OF",
            "COMPARED_WITH",
            "EXPLAINED_BY",
            "DEBUNKED_BY",
            "ATTESTS_MOTIF",
            "PART_OF_MACRO_TREND",
            "OSTENSION_OF"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
          "title": "Target",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "confirmed",
                "contested",
                "unverified",
                "refuted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "type",
        "target"
      ],
      "title": "Relation",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "doi": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "local_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Path"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        }
      },
      "required": [
        "citation",
        "type"
      ],
      "title": "Source",
      "type": "object"
    },
    "Spatial": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lng": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lng"
        },
        "precision": {
          "enum": [
            "exact",
            "city",
            "province",
            "culture_region",
            "global"
          ],
          "title": "Precision",
          "type": "string"
        },
        "location_name": {
          "minLength": 1,
          "title": "Location Name",
          "type": "string"
        },
        "culture_region": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Culture Region"
        }
      },
      "required": [
        "precision",
        "location_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "Standards": {
      "additionalProperties": false,
      "properties": {
        "atu_types": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Atu Types",
          "type": "array"
        },
        "thompson_motifs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Thompson Motifs",
          "type": "array"
        },
        "berezkin_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Berezkin Codes",
          "type": "array"
        },
        "ocm_codes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ocm Codes",
          "type": "array"
        },
        "macro_phylogeny": {
          "anyOf": [
            {
              "enum": [
                "Laurasian",
                "Gondwanan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Macro Phylogeny"
        }
      },
      "title": "Standards",
      "type": "object"
    },
    "Temporal": {
      "additionalProperties": false,
      "properties": {
        "year_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year Start"
        },
        "year_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year End"
        },
        "era_label": {
          "minLength": 1,
          "title": "Era Label",
          "type": "string"
        },
        "uncertainty_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Note"
        }
      },
      "required": [
        "era_label"
      ],
      "title": "Temporal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "aliases": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "node_type": {
      "enum": [
        "case",
        "myth_corpus",
        "motif_index",
        "mechanism",
        "theory"
      ],
      "title": "Node Type",
      "type": "string"
    },
    "z_layer": {
      "maximum": 4,
      "minimum": 1,
      "title": "Z Layer",
      "type": "integer"
    },
    "genre": {
      "enum": [
        "myth",
        "fabulate",
        "memorate",
        "folktale",
        "urban_legend",
        "creepypasta_ostension",
        "historical_archive",
        "academic_model",
        "unclassified"
      ],
      "title": "Genre",
      "type": "string"
    },
    "credibility_tier": {
      "enum": [
        "S",
        "A",
        "B",
        "C",
        "F"
      ],
      "title": "Credibility Tier",
      "type": "string"
    },
    "is_fictional_quarantine": {
      "title": "Is Fictional Quarantine",
      "type": "boolean"
    },
    "spatial": {
      "anyOf": [
        {
          "$ref": "#/$defs/Spatial"
        },
        {
          "type": "null"
        }
      ]
    },
    "temporal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Temporal"
        },
        {
          "type": "null"
        }
      ]
    },
    "standards": {
      "$ref": "#/$defs/Standards"
    },
    "mechanisms": {
      "items": {
        "$ref": "#/$defs/MechanismReference"
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/Relation"
      },
      "title": "Relations",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "audit": {
      "$ref": "#/$defs/Audit"
    }
  },
  "required": [
    "id",
    "title",
    "node_type",
    "z_layer",
    "genre",
    "credibility_tier",
    "is_fictional_quarantine",
    "spatial",
    "temporal",
    "standards",
    "sources",
    "audit"
  ],
  "title": "NodeMetadata",
  "type": "object"
}
